# Token da aplicação no Discord Developer Portal.
DISCORD_TOKEN=

# Caminho do arquivo SQLite. Caminhos relativos partem da pasta do projeto.
# O diretório data/ é criado automaticamente.
DATABASE_PATH=data/community_bot.sqlite3

# Opcional: sincroniza comandos apenas neste servidor durante desenvolvimento.
# Em produção, deixe vazio para sincronização global.
GUILD_ID=

# Categoria padrão para criação de tickets, caso não seja definida em /ticket-config.
TICKET_CATEGORY_ID=
